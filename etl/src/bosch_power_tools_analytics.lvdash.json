{
  "datasets": [
    {
      "displayName": "Total Orders",
      "name": "total_orders",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS total_orders\n",
        "FROM\n",
        "  nikks_fevm_workspace_7405607030687545.techsummit.fact_purchase"
      ]
    },
    {
      "displayName": "Revenue by Product",
      "name": "revenue_by_product",
      "queryLines": [
        "SELECT\n",
        "  p.name AS product_name,\n",
        "  ROUND(SUM(pl.quantity * pl.unit_price_eur), 2) AS revenue_eur\n",
        "FROM\n",
        "  nikks_fevm_workspace_7405607030687545.techsummit.fact_purchase_line pl\n",
        "    JOIN nikks_fevm_workspace_7405607030687545.techsummit.dim_product p\n",
        "      ON pl.product_id = p.product_id\n",
        "GROUP BY\n",
        "  p.name\n",
        "ORDER BY\n",
        "  revenue_eur DESC"
      ]
    },
    {
      "displayName": "Revenue by Country",
      "name": "revenue_by_country",
      "queryLines": [
        "SELECT\n",
        "  c.country,\n",
        "  ROUND(SUM(fp.total_eur), 2) AS revenue_eur\n",
        "FROM\n",
        "  nikks_fevm_workspace_7405607030687545.techsummit.fact_purchase fp\n",
        "    JOIN nikks_fevm_workspace_7405607030687545.techsummit.dim_customer c\n",
        "      ON fp.customer_id = c.customer_id\n",
        "GROUP BY\n",
        "  c.country\n",
        "ORDER BY\n",
        "  revenue_eur DESC"
      ]
    },
    {
      "displayName": "Total Revenue",
      "name": "total_revenue",
      "queryLines": [
        "SELECT\n",
        "  ROUND(SUM(total_eur), 2) AS total_revenue_eur\n",
        "FROM\n",
        "  nikks_fevm_workspace_7405607030687545.techsummit.fact_purchase"
      ]
    },
    {
      "displayName": "Total Product Views",
      "name": "total_views",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS total_views\n",
        "FROM\n",
        "  nikks_fevm_workspace_7405607030687545.techsummit.event_view_item"
      ]
    },
    {
      "displayName": "Views by Product",
      "name": "views_by_product",
      "queryLines": [
        "SELECT\n",
        "  p.name AS product_name,\n",
        "  COUNT(*) AS view_count\n",
        "FROM\n",
        "  nikks_fevm_workspace_7405607030687545.techsummit.event_view_item ev\n",
        "    JOIN nikks_fevm_workspace_7405607030687545.techsummit.dim_product p\n",
        "      ON ev.product_id = p.product_id\n",
        "GROUP BY\n",
        "  p.name\n",
        "ORDER BY\n",
        "  view_count ASC"
      ]
    },
    {
      "displayName": "Total Cart Actions",
      "name": "total_cart",
      "queryLines": [
        "SELECT\n",
        "  COUNT(*) AS total_cart_actions\n",
        "FROM\n",
        "  nikks_fevm_workspace_7405607030687545.techsummit.event_add_to_cart"
      ]
    },
    {
      "displayName": "Product Catalog",
      "name": "product_catalog",
      "queryLines": [
        "SELECT\n",
        "  p.name,\n",
        "  p.category,\n",
        "  p.price_eur,\n",
        "  s.voltage_v,\n",
        "  s.max_torque_nm,\n",
        "  s.weight_kg,\n",
        "  s.battery_platform\n",
        "FROM\n",
        "  nikks_fevm_workspace_7405607030687545.techsummit.dim_product p\n",
        "    LEFT JOIN nikks_fevm_workspace_7405607030687545.techsummit.idp_product_specs s\n",
        "      ON p.name = s.model_name\n",
        "ORDER BY\n",
        "  p.name"
      ]
    },
    {
      "displayName": "Cart by Product",
      "name": "cart_by_product",
      "queryLines": [
        "SELECT\n",
        "  p.name AS product_name,\n",
        "  COUNT(*) AS cart_count\n",
        "FROM\n",
        "  nikks_fevm_workspace_7405607030687545.techsummit.event_add_to_cart ac\n",
        "    JOIN nikks_fevm_workspace_7405607030687545.techsummit.dim_product p\n",
        "      ON ac.product_id = p.product_id\n",
        "GROUP BY\n",
        "  p.name\n",
        "ORDER BY\n",
        "  cart_count ASC"
      ]
    },
    {
      "displayName": "Purchases per Day",
      "name": "purchases_per_day",
      "queryLines": [
        "SELECT\n",
        "  DATE(created_at) AS purchase_day,\n",
        "  COUNT(*) AS purchase_count,\n",
        "  ROUND(SUM(total_eur), 2) AS revenue_eur\n",
        "FROM\n",
        "  nikks_fevm_workspace_7405607030687545.techsummit.fact_purchase\n",
        "GROUP BY\n",
        "  DATE(created_at)\n",
        "ORDER BY\n",
        "  purchase_day"
      ]
    },
    {
      "displayName": "Sales by Selected Date",
      "name": "sales_by_date",
      "parameters": [
        {
          "complexType": "MULTI",
          "dataType": "DATE",
          "defaultSelection": {
            "values": {
              "dataType": "DATE",
              "values": [
                {
                  "value": "2026-09-29"
                }
              ]
            }
          },
          "displayName": "Selected Date",
          "keyword": "selected_date"
        }
      ],
      "queryLines": [
        "SELECT\n",
        "  ROUND(SUM(total_eur), 2) AS revenue_eur\n",
        "FROM\n",
        "  nikks_fevm_workspace_7405607030687545.techsummit.fact_purchase\n",
        "WHERE\n",
        "  (\n",
        "    :selected_date IS NULL\n",
        "    OR array_contains(:selected_date, DATE(created_at))\n",
        "  )"
      ]
    }
  ],
